# ============================================================================
# Acme Commerce — environment configuration template
# ============================================================================
# Copy to `.env` for local development:  cp .env.example .env
#
# `.env` is gitignored. This file is committed and must never contain a real
# credential. Every value below is a placeholder.
#
# The application reads configuration ONLY from the environment. There is no
# config file baked into the image, which is what makes the same image runnable
# unchanged on your laptop and on Unraid.
# ============================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# APP_ENV drives behaviour that must differ by environment: `production` disables
# destructive tooling and development-only endpoints. Values: development | test | production
APP_ENV=development

# NODE_ENV is respected by libraries in the Node ecosystem. Keep it aligned with APP_ENV.
NODE_ENV=development

# Interface to bind. Use 127.0.0.1 locally; 0.0.0.0 inside a container so Docker can route to it.
HOST=127.0.0.1
PORT=3000

# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Human-readable coloured logs for a terminal. Leave false in containers and CI:
# machine-readable JSON is what a log aggregator can actually query.
LOG_PRETTY=true

# ---------------------------------------------------------------------------
# Database — primary application connection
# ---------------------------------------------------------------------------
# Two supported styles. Provide EITHER DATABASE_URL OR the discrete PG* variables.
# Setting both is rejected at startup rather than silently resolved in a
# surprising direction.
#
# Style A — single connection string (preferred on Unraid: one field to paste)
DATABASE_URL=postgres://REPLACE_USER:REPLACE_PASSWORD@REPLACE_HOST:5432/acme_commerce

# Style B — discrete variables (preferred in CI and when overriding one piece)
# PGHOST=REPLACE_HOST
# PGPORT=5432
# PGDATABASE=acme_commerce
# PGUSER=REPLACE_USER
# PGPASSWORD=REPLACE_PASSWORD

# TLS behaviour toward PostgreSQL:
#   disable   — no TLS. Correct on a private Docker network.
#   require   — TLS required, certificate chain verified. Correct across an untrusted network.
#   no-verify — TLS required, certificate NOT verified. Encrypts the wire but does not
#               authenticate the server, so it does not stop an active attacker. Use only
#               for a self-signed certificate you cannot yet replace.
DB_SSL=disable

# Connection pool. DB_POOL_MAX is per application container: two replicas at 10 each
# open 20 server-side connections. PostgreSQL's own max_connections is the ceiling.
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_CONNECT_TIMEOUT_MS=10000

# Server-side cap on any single statement. A runaway query fails instead of holding a
# connection open forever. 0 disables the cap.
DB_STATEMENT_TIMEOUT_MS=15000

# The dedicated PostgreSQL schema owned by this application. Changing it is supported but
# uncommon; it exists so Acme Commerce can share a database without touching anything else.
DB_SCHEMA=acme

# ---------------------------------------------------------------------------
# Migrations
# ---------------------------------------------------------------------------
# Whether to apply pending migrations automatically when the process boots.
# Default false, deliberately. Automatic migration on boot is convenient, and it is also
# how two container replicas start the same migration at the same moment. Run migrations
# as an explicit step: `npm run migrate:up` (or `node dist/db/cli.js up` in the container).
MIGRATE_ON_STARTUP=false

# ---------------------------------------------------------------------------
# Test database — used ONLY by automated integration tests
# ---------------------------------------------------------------------------
# Must resolve to a different (host, port, database) than the application connection above.
# The safety guard in src/db/guard.ts refuses to run destructive test tooling if it does not,
# and refuses if the database name does not look like a test database.
TEST_DATABASE_URL=postgres://REPLACE_USER:REPLACE_PASSWORD@REPLACE_HOST:5432/acme_commerce_test

# ---------------------------------------------------------------------------
# Not used in Milestone 1
# ---------------------------------------------------------------------------
# Introduced in Milestone 2 (authentication). Listed so the template stays honest about
# what is coming. The application does not read these yet.
# AUTH_TOKEN_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING
# AUTH_TOKEN_TTL_SECONDS=3600
