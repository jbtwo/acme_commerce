# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# Test output
coverage/
test-results/

# Local configuration and secrets.
# .env holds real local credentials and must never be committed.
# .env.example is the committed template and IS tracked.
.env
.env.*
!.env.example

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp
*.swo
*~

# Temporary artifacts from openapi:check
openapi/.openapi.generated.json

# Generated by scripts/dev-postgres.sh — local throwaway database credentials.
.dev-postgres.env

# Editor swap files inside Postman's git-integration directories. Postman writes these paths,
# so a stray swap file lands in a directory that is otherwise fully tracked and gets committed
# by a `git add -A` that looks perfectly reasonable.
postman/**/.*.swp
postman/**/.*.swo
