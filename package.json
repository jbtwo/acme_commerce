{
  "name": "acme-commerce",
  "version": "0.2.0",
  "private": true,
  "description": "Acme Commerce — an ecommerce API platform used as a controlled API-engineering learning environment.",
  "type": "module",
  "engines": {
    "node": ">=26.0.0 <27"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "migrate:up": "tsx src/db/cli.ts up",
    "migrate:down": "tsx src/db/cli.ts down",
    "migrate:status": "tsx src/db/cli.ts status",
    "migrate:create": "tsx src/db/cli.ts create",
    "db:seed": "tsx src/db/cli.ts seed",
    "db:reset": "tsx src/db/cli.ts reset",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "openapi:generate": "tsx src/openapi/generate.ts",
    "openapi:check": "tsx src/openapi/generate.ts --check",
    "openapi:lint": "redocly lint openapi/openapi.json",
    "smoke": "bash scripts/smoke.sh",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run openapi:check && npm run openapi:lint"
  },
  "dependencies": {
    "@fastify/swagger": "9.8.1",
    "@fastify/swagger-ui": "6.1.1",
    "@sinclair/typebox": "0.34.52",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "fastify": "5.12.1",
    "kysely": "0.29.5",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@redocly/cli": "2.49.1",
    "@types/node": "26.4.0",
    "@types/pg": "8.23.1",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.11"
  }
}
